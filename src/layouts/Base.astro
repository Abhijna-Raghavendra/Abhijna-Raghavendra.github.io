---
const { title = 'Abhijna Raghavendra', description = 'Abhijna Raghavendra — post-quantum cryptography, proof systems and coding theory.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#faf9f6" />
  <title>{title}</title>
  <script is:inline>
    try { document.documentElement.dataset.theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light'; } catch {}
  </script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />
  <style is:global>
    :root { color-scheme: light; --bg:#faf9f6; --text:#292632; --muted:#727078; --rule:#e3e0e6; --accent:#7560a6; --accent-soft:#eee9f6; --panel:#fffefa; }
    :root[data-theme="dark"] { color-scheme:dark; --bg:#1c1b20; --text:#edeaf1; --muted:#aaa5b2; --rule:#39353f; --accent:#bca7e0; --accent-soft:#332b41; --panel:#242128; }
    *,*::before,*::after { box-sizing:border-box; }
    html { scroll-behavior:smooth; scroll-padding-top:100px; -webkit-text-size-adjust:100%; }
    body { margin:0; background:var(--bg); color:var(--text); font-family:'DM Sans',system-ui,sans-serif; font-size:15px; line-height:1.75; }
    main { max-width:1120px; margin:auto; padding:0 48px; }
    a { color:inherit; text-decoration-color:var(--rule); text-underline-offset:5px; transition:color .2s; }
    a:hover { color:var(--accent); text-decoration-color:currentColor; }
    a:focus-visible,button:focus-visible,summary:focus-visible { outline:2px solid var(--accent); outline-offset:6px; }
    h1,h2,h3,p { margin:0; }
    h1,h2 { font-family:'Newsreader',Georgia,serif; font-weight:400; }
    h1 { font-size:clamp(46px,6vw,76px); line-height:1.04; letter-spacing:-.04em; }
    h2 { font-size:36px; line-height:1.2; letter-spacing:-.025em; margin-bottom:30px; }
    h3 { font-size:17px; line-height:1.5; font-weight:500; }
    p+p { margin-top:14px; }
    button { font:inherit; color:inherit; cursor:pointer; }
    .small,.meta { color:var(--muted); font-size:13px; }
    .eyebrow { color:var(--muted); font-size:10px; letter-spacing:.17em; text-transform:uppercase; font-weight:600; }
    .row { display:flex; justify-content:space-between; gap:20px; }
    .when { color:var(--muted); font-size:12px; white-space:nowrap; padding-top:4px; }
    .plain { list-style:none; padding:0; margin:0; }
    .plain>li { padding:22px 0; border-top:1px solid var(--rule); }
    .plain p { margin-top:10px; }
    .item-title { font-weight:500; }
    .tag { display:inline-block; font-size:10px; padding:2px 8px; margin:6px 4px 0 0; background:var(--accent-soft); border-radius:3px; }
    .skip { position:absolute; top:-100px; left:20px; background:var(--bg); padding:12px; z-index:10; }
    .skip:focus { top:10px; }
    body:has(.project-list) main { padding-top:60px; padding-bottom:80px; max-width:850px; }
    @media(max-width:700px) { main { padding:0 24px; } h2 { font-size:32px; } .row { flex-wrap:wrap; gap:4px; } }
    @media(prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } *,*::before,*::after { animation:none!important; transition:none!important; } }
  </style>
</head>
<body><a class="skip" href="#content">Skip to content</a><main id="content"><slot /></main></body>
</html>
