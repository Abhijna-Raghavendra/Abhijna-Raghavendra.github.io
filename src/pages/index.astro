---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

// A local link only renders if the file actually exists in public/.
// Missing files are logged at build time so a bad filename doesn't vanish silently.
const has = (p: string) => {
  const ok = fs.existsSync(`public/${p}`);
  if (!ok) console.warn(`[index.astro] public/${p} not found; its link is hidden.`);
  return ok;
};
const available = (links: {href: string; label: string}[] = []) =>
  links.filter(l => !l.href.startsWith('/') || has(l.href.slice(1)));


const thesis = '/papers/ms-thesis-code-based-signatures.pdf';

type Card = {
  art: string; symbol: string; kind: string; year: string; title: string;
  award?: string; where?: string; description: string;
  links: {href: string; label: string}[];
};

const research: Card[] = [
  {
    art: 'sigma', symbol: 'Σ',
    kind: 'Master’s thesis', year: '2025–26',
    title: 'Code-based post-quantum digital signature schemes',
    award: 'Best Thesis Award · Department of Mathematics, IIT Roorkee',
    where: 'Supervised by Prof. Maheshanand Bhaintwal',
    description: 'Examines the landscape of code-based signature schemes, categorizing them as hash-and-sign based and zero-knowledge based, and analyzes the attacks on them and the techniques used to mitigate them. Presents a novel scheme based on the MPCitH paradigm with hardness coming from R-SDP(G), providing an estimated 50% reduction in signature size over CROSS.',
    links: [{href: thesis, label: 'Thesis (PDF)'}],
  },
  {
    art: 'grid', symbol: '𝔽₂',
    kind: 'Summer research internship', year: '2024',
    title: 'Binary group ring codes',
    where: 'Department of Mathematics, IIT Roorkee',
    description: 'A literature review of group ring codes, centred on Tan, Ang and Teh’s conjecture that every binary code over a dihedral group is equivalent to a cyclic one, and the analogous question for Cₙ ⋊ C₃. Included implementing code-equivalence checks in SageMath.',
    links: [{href: '/papers/binary-group-ring-codes-notes.pdf', label: 'Preliminary notes (PDF)'}],
  },
];

const projects: Card[] = [
  {
    art: 'plus', symbol: '⊕',
    kind: 'Course project', year: '2025',
    title: 'Homomorphic AES over TFHE',
    where: 'CSL-513: Information and Network Security, IIT Roorkee',
    description: 'A study of the TFHE scheme and of homomorphic AES, up to the Hippogryph implementation. We then tried applying AlphaTensor-discovered matrix multiplication to MixColumns: a direct transfer adds bootstrapping instead of saving it, and the report explains why and where a learned search could still help.',
    links: [{href: '/papers/aes-tfhe-alphatensor-report.pdf', label: 'Project report (PDF)'}],
  },
  {
    art: 'nodes', symbol: '⋈',
    kind: 'Course project', year: '2025',
    title: 'Networking for secure multi-party computation',
    where: 'CSL-529: Advanced Computer Networks, IIT Roorkee',
    description: 'Container networking (CNI) as the communication layer for secure multi-party computation. Implemented MPC with additive secret sharing over finite fields, including Beaver-triple multiplication in the semi-honest model, running as containerized parties over secure channels.',
    links: [
      {href: '/papers/smpc_cni_ppt.pdf', label: 'Slides (PDF)'},
      {href: 'https://github.com/ashpect/smpc-cni', label: 'Code'},
    ],
  },
];

const groups = [
  {id: 'research', title: 'Research', items: research},
  {id: 'projects', title: 'Projects', items: projects},
];
const count = (n: number) => `${String(n).padStart(2, '0')} ${n === 1 ? 'project' : 'projects'}`;
---
<Base>
<div class="academic-site">
  <aside class="profile">
    <div class="profile-top"><img class="portrait" src="/abhijna-raghavendra.jpeg" alt="Abhijna Raghavendra on a mountain hike" width="1200" height="1600" fetchpriority="high" /></div>
    <h1>Abhijna<br />Raghavendra<span>.</span></h1>
    <ul class="profile-interests" aria-label="Research interests"><li>Post-quantum cryptography</li><li>Proof systems</li><li>Coding theory</li></ul>
    <p class="profile-bio">I’m a cryptography enthusiast with a degree in Mathematics and Computing from IIT Roorkee. I build software at Oracle NetSuite and have a weakness for problems that put up a fight.</p>
    <p class="profile-bio">When I’m not doing that, you’ll find me on a <span class="hint hint-ball" tabindex="0"><span class="ball" aria-hidden="true">🏀</span>basketball cour<span class="t">t</span></span>, <a href="/projects">building side projects</a>, or on a <span class="hint hint-hike" tabindex="0" data-hint="Exhibit A ↑">scenic hike</span>.</p>
    <div class="socials">
      <a href="mailto:contact.abhijna@gmail.com">Email ↗</a>
      {has('cv.pdf') && <a href="/cv.pdf">CV ↗</a>}
      <a href="https://github.com/Abhijna-Raghavendra/">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/abhijna-raghavendra-696b2924b/">LinkedIn ↗</a>
    </div>
  </aside>

  <div class="workspace">
    <header class="topbar">
      <nav aria-label="On this page">
        <a href="#publications" aria-current="location">Publications</a>
        <a href="#research">Research</a>
        <a href="#projects">Projects</a>
        <a href="#background">Background</a>
      </nav>
      <ThemeToggle />
    </header>

    <section id="publications" aria-labelledby="publications-title">
      <div class="section-heading"><h2 id="publications-title">Publications</h2><span class="eyebrow">2026</span></div>
      <article class="publication">
        <span class="publication-venue">IMACC 2026 <span>· To appear</span></span>
        <h3>On the Soundness of a Consistency Check for <span class="nb">R-SDP(G)-Based</span> MPCitH Signatures</h3>
        <p class="authors"><strong>A. Raghavendra</strong> and M. Bhaintwal</p>
        <p class="small">20th IMA International Conference on Cryptography and Coding · Cirencester, UK, December 2026 · Springer LNCS</p>
        <p class="abstract">We extend the MPC-in-the-Head signature scheme of Battagliola, Chen, Sauerbier Couvée and Weger from the restricted syndrome decoding problem <span class="nb">R-SDP</span> to its subgroup variant <span class="nb">R-SDP(G)</span>, the problems underlying the code-based NIST candidate CROSS. Under a heuristic estimate, the resulting signatures are roughly half the size of <span class="nb">CROSS-R-SDP(G)</span> small. We also analyse the soundness of the protocol’s permutation-based consistency check, showing when it fails in the worst case and characterizing the conditions under which it nonetheless remains sound.</p>
        <p class="small manuscript-note">The manuscript will be posted here once the proceedings are published.</p>
      </article>
    </section>

    {groups.map(g => (
      <section id={g.id} class="research-section" aria-labelledby={`${g.id}-title`}>
        <div class="section-heading"><h2 id={`${g.id}-title`}>{g.title}</h2><span class="eyebrow">{count(g.items.length)}</span></div>
        <div class="research-list">
          {g.items.map((r, i) => {
            const links = available(r.links);
            return (
              <article class="research-card">
                <div class={`research-art art-${r.art}`} aria-hidden="true">
                  <svg viewBox="0 0 120 120">
                    <defs><pattern id={`grid-${g.id}-${i}`} width="15" height="15" patternUnits="userSpaceOnUse"><path d="M 15 0 L 0 0 0 15" fill="none" stroke="currentColor" stroke-width=".4" /></pattern></defs>
                    <rect width="120" height="120" fill={`url(#grid-${g.id}-${i})`} />
                    {r.art === 'sigma' && <><path d="M20 85 60 15 100 85Z M20 35 100 35 60 105Z" fill="none" stroke="currentColor" stroke-width="1.2" /><circle cx="60" cy="60" r="29" fill="none" stroke="currentColor" /></>}
                    {r.art === 'grid' && [24,48,72,96].map((x, j) => <><path d={`M24 ${x} H96 M${x} 24 V96`} fill="none" stroke="currentColor" stroke-width=".7" /><circle cx={x} cy={[72,24,96,48][j]} r="5" fill="currentColor" /></>)}
                    {r.art === 'plus' && <><rect x="26" y="26" width="68" height="68" rx="12" fill="none" stroke="currentColor" /><path d="M40 60 H80 M60 40 V80" fill="none" stroke="currentColor" stroke-width="2" /><circle cx="60" cy="60" r="26" fill="none" stroke="currentColor" /></>}
                    {r.art === 'nodes' && <><path d="M60 28 L30 82 L90 82Z M60 28 L60 64 M30 82 L60 64 M90 82 L60 64" fill="none" stroke="currentColor" stroke-width=".9" /><circle cx="60" cy="28" r="7" fill="currentColor" /><circle cx="30" cy="82" r="7" fill="currentColor" /><circle cx="90" cy="82" r="7" fill="currentColor" /><circle cx="60" cy="64" r="4" fill="none" stroke="currentColor" stroke-width="1.2" /></>}
                  </svg>
                  <span>{r.symbol}</span>
                </div>
                <div class="research-text">
                  <div class="research-meta"><span>{r.kind}</span><span>{r.year}</span></div>
                  <h3>{r.title}</h3>
                  {r.award && <p class="research-award">{r.award}</p>}
                  {r.where && <p class="research-where">{r.where}</p>}
                  <p>{r.description}</p>
                  {links.length > 0 && <p class="research-links">{links.map(l => <a href={l.href}>{l.label} {l.href.startsWith('#') ? '↑' : '↗'}</a>)}</p>}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))}

    <section id="background" aria-labelledby="background-title">
      <div class="section-heading"><h2 id="background-title">Background</h2><span class="eyebrow">Hover a stop</span></div>
      <div class="timeline">
        <div class="track" aria-hidden="true">
          <div class="bobble">
            <div class="bobble-head"></div>
            <svg class="bobble-neck" viewBox="0 0 10 8" preserveAspectRatio="none"><path d="M5 0 L1 2 L9 4 L1 6 L5 8" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" /></svg>
            <svg class="bobble-body" viewBox="0 0 30 20"><path d="M3 20 Q3 6 15 5 Q27 6 27 20Z" fill="currentColor" /><path d="M11 5.5 L15 11 L19 5.5" fill="none" stroke="var(--bg)" stroke-width="1.4" /></svg>
          </div>
        </div>
        <ol class="stops">
          <li class="stop" tabindex="0">
            <div class="stop-art art-office" aria-hidden="true">
              <svg viewBox="0 0 140 90">
                <path d="M8 84 H132" stroke="currentColor" stroke-width="1" />
                <rect x="48" y="10" width="44" height="74" rx="2" fill="none" stroke="currentColor" stroke-width="1.3" />
                <path d="M48 10 L70 4 L92 10" fill="none" stroke="currentColor" stroke-width="1.1" />
                <g fill="currentColor" opacity=".55">{[0,1,2,3,4,5,6,7].map(r => [0,1,2,3].map(c => <rect x={53 + c*9.5} y={15 + r*7.6} width="6" height="4.4" rx=".6" />))}</g>
                <rect x="64" y="74" width="12" height="10" fill="none" stroke="currentColor" stroke-width="1.1" />
                <rect x="96" y="40" width="28" height="44" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.1" />
                <g fill="currentColor" opacity=".4">{[0,1,2,3].map(r => [0,1].map(c => <rect x={101 + c*10} y={45 + r*9} width="7" height="5" rx=".6" />))}</g>
                <rect x="16" y="52" width="28" height="32" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.1" />
                <g fill="currentColor" opacity=".4">{[0,1,2].map(r => [0,1].map(c => <rect x={21 + c*10} y={57 + r*8.5} width="7" height="5" rx=".6" />))}</g>
              </svg>
            </div>
            <div class="stop-text">
              <p class="stop-meta"><span>Work</span><span>2026–present</span></p>
              <h3>Oracle NetSuite</h3>
              <p class="stop-sub">Application Software Engineer</p>
              <div class="stop-more"><div><p>Platform Solutions Group, Internationalization team. Country-specific localization of tax calculation and statutory reporting from general-ledger data, translating local regulations into configurable logic.</p></div></div>
            </div>
          </li>
          <li class="stop" tabindex="0">
            <div class="stop-art art-campus" aria-hidden="true">
              <svg viewBox="0 0 140 90">
                <path d="M4 84 H136" stroke="currentColor" stroke-width="1" />
                <path d="M54 84 V80 H86 V84 M58 80 V77 H82 V80" fill="none" stroke="currentColor" stroke-width="1" />
                <rect x="10" y="48" width="120" height="29" fill="none" stroke="currentColor" stroke-width="1.3" />
                <path d="M10 48 V44 H130 V48" fill="none" stroke="currentColor" stroke-width="1" />
                <g fill="none" stroke="currentColor" stroke-width=".9">{[16,26,36,46,88,98,108,118].map(x => <path d={`M${x} 72 V60 Q${x+3} 55 ${x+6} 60 V72`} />)}</g>
                <rect x="56" y="30" width="28" height="47" fill="var(--bg)" stroke="currentColor" stroke-width="1.3" />
                <path d="M53 30 H87" stroke="currentColor" stroke-width="1.3" />
                <path d="M58 30 Q70 8 82 30" fill="var(--bg)" stroke="currentColor" stroke-width="1.3" />
                <path d="M70 13 V5" stroke="currentColor" stroke-width="1" /><circle cx="70" cy="13.2" r="1.6" fill="currentColor" />
                <path d="M63 77 V58 Q70 48 77 58 V77" fill="none" stroke="currentColor" stroke-width="1.1" />
                <g fill="none" stroke="currentColor" stroke-width=".9"><path d="M59 50 V40 Q61 37 63 40 V50" /><path d="M77 50 V40 Q79 37 81 40 V50" /></g>
              </svg>
            </div>
            <div class="stop-text">
              <p class="stop-meta"><span>Study</span><span>2021–2026</span></p>
              <h3>IIT Roorkee</h3>
              <p class="stop-sub">Integrated BS-MS in Mathematics and Computing</p>
              <div class="stop-more"><div><p>Minor in Computer Science and Engineering · CGPA 9.27/10.</p><p>Deputy General Secretary, Sports · Captain, institute women’s basketball team · Project Manager, MDG Space · Executive Member, Enactus.</p></div></div>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <footer><div class="footer-meta"><span>© {new Date().getFullYear()} Abhijna Raghavendra</span><a href="#content">Back to top ↑</a></div></footer>
  </div>
</div>
</Base>
<style is:global>
body:has(.academic-site) main { max-width:1280px; padding:0 48px; }
body:has(.academic-site) { background:var(--bg); }
:root { --t-violet:#7560a6; --t-violet-bg:#eee9f6; --t-plum:#94588f; --t-plum-bg:#f5e8f2; --t-teal:#3c7d76; --t-teal-bg:#e2f0ed; --t-slate:#4d6d8f; --t-slate-bg:#e5ecf4; --t-ochre:#a2723a; --t-ochre-bg:#f5ecdc; --t-terra:#a65d4b; --t-terra-bg:#f6e6e1; }
:root[data-theme="dark"] { --t-violet:#bca7e0; --t-violet-bg:#332b41; --t-plum:#d6a5cf; --t-plum-bg:#3b2a38; --t-teal:#8ccfc5; --t-teal-bg:#1f3431; --t-slate:#a5bfdc; --t-slate-bg:#243143; --t-ochre:#e2b67f; --t-ochre-bg:#3a2f21; --t-terra:#e5a392; --t-terra-bg:#3e2a25; }
@media(max-width:550px) { body:has(.academic-site) main { padding:0 22px; } }
</style>
<style>
.academic-site { display:grid; grid-template-columns:290px minmax(0,1fr); gap:90px; }
.profile { position:sticky; top:38px; align-self:start; padding:0 0 35px; margin-top:38px; }
.profile-top { display:flex; align-items:flex-end; gap:16px; margin-bottom:27px; }.portrait { width:132px; height:146px; border-radius:8px; object-fit:cover; object-position:50% 50%; }
h1 { font-family:'DM Sans',system-ui,sans-serif; font-size:36px; font-weight:500; line-height:1.12; letter-spacing:-1.6px; }h1>span { color:var(--accent); }.profile-bio { color:var(--muted); font-size:13px; line-height:1.85; margin-top:25px; }.profile-bio+.profile-bio { margin-top:12px; }.profile-bio a { color:var(--text); }
.socials { display:flex; flex-wrap:wrap; gap:18px; margin-top:25px; font-size:11px; }.socials a { text-decoration:none; }.socials a:hover { text-decoration:underline; }
.workspace { min-width:0; }.topbar { display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:5; height:81px; background:var(--bg); border-bottom:1px solid var(--rule); }.topbar nav { display:flex; gap:27px; }nav a { font-size:11px; text-decoration:none; color:var(--muted); position:relative; }nav a[aria-current] { color:var(--accent); }nav a::after { content:''; position:absolute; bottom:-29px; left:0; width:100%; height:2px; background:var(--accent); transform:scaleX(0); transition:transform .25s; }nav a[aria-current]::after { transform:scaleX(1); }
#publications { padding-top:32px; }
.profile { container-type:inline-size; }.profile-interests { display:flex; list-style:none; padding:0; margin:14px 0 0; font-size:min(3.4cqi,11.5px); line-height:1.7; color:var(--accent); white-space:nowrap; }.profile-interests li+li::before { content:'|'; margin:0 .55em; color:var(--muted); opacity:.6; }
.hint { position:relative; color:var(--text); cursor:default; }
.profile-bio :is(a,.hint) { text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:3px; text-decoration-color:color-mix(in srgb, currentColor 35%, transparent); }
.hint-hike::after { position:absolute; left:50%; pointer-events:none; opacity:0; transition:opacity .2s, transform .2s; }
/* Basketball: the ball is shot from the "b" into a hoop that grows out of the "t". */
.hint-ball { white-space:nowrap; --stem-x:.163em; --hoop-x:1.59em; --rim-y:-.69em; }
.hint-ball .t { position:relative; display:inline-block; line-height:1; }
.hint-ball .t::before { content:''; position:absolute; left:calc(var(--stem-x) - .65px); bottom:.62em; width:1.3px; height:.98em; background:currentColor; transform:scaleY(0); transform-origin:bottom; transition:transform .25s ease-out; }
.hint-ball .t::after { content:''; position:absolute; right:calc(100% - var(--stem-x) + .65px); bottom:1.07em; width:1.05em; height:.45em; border-top:1.6px solid #e8743b; background:repeating-linear-gradient(90deg, color-mix(in srgb, currentColor 45%, transparent) 0 .7px, transparent .7px 2.4px), var(--bg); clip-path:polygon(0 0,100% 0,80% 100%,20% 100%); opacity:0; transition:opacity .15s; }
.hint-ball:is(:hover,:focus) .t::before { transform:scaleY(1); }
.hint-ball:is(:hover,:focus) .t::after { opacity:1; transition-delay:.2s; }
.hint-ball .ball { position:absolute; left:0; bottom:80%; font-size:.7em; line-height:1; opacity:0; pointer-events:none; }
.hint-ball:is(:hover,:focus) .ball { animation:shot-x 1.1s .35s linear both, shot-y 1.1s .35s both, spin 1.1s .35s linear both; }
@keyframes shot-x { 0% { left:0; } 72%, 100% { left:calc(100% - var(--hoop-x, 1.25em)); } }
@keyframes shot-y { 0% { opacity:1; translate:0 0; animation-timing-function:cubic-bezier(.2,.6,.4,1); } 38% { translate:0 -3.3em; animation-timing-function:cubic-bezier(.6,0,.8,.4); } 72% { opacity:1; translate:0 var(--rim-y, -.6em); animation-timing-function:ease-in; } 100% { opacity:0; translate:0 calc(var(--rim-y, -.6em) + 1em); } }
@keyframes spin { to { rotate:-540deg; } }
.hint-hike::after { content:attr(data-hint); bottom:calc(100% + 6px); transform:translate(-50%,4px); white-space:nowrap; font-size:10px; padding:2px 7px; border-radius:4px; background:var(--accent); color:var(--bg); }
.hint-hike:is(:hover,:focus)::after { opacity:1; transform:translate(-50%,0); }
.portrait { transition:transform .35s, box-shadow .35s; }.profile:has(.hint-hike:is(:hover,:focus)) .portrait { transform:rotate(-3deg) scale(1.05); box-shadow:0 0 0 3px var(--accent); }
@media(prefers-reduced-motion:reduce) { .hint-ball:is(:hover,:focus) .ball { animation:none; opacity:1; left:calc(100% - var(--hoop-x, 1.25em)); translate:0 var(--rim-y, -.6em); } .hint-ball .t::before { transition:none; } .profile:has(.hint-hike:is(:hover,:focus)) .portrait { transform:none; } }

section[id] { scroll-margin-top:105px; }.section-heading { display:flex; align-items:center; justify-content:space-between; gap:18px; margin-bottom:22px; }.section-heading h2,#background>h2 { font-family:'DM Sans',sans-serif; font-size:20px; font-weight:500; letter-spacing:-.6px; margin:0; }.section-heading .eyebrow { font-size:9px; letter-spacing:.08em; }
.research-card { display:grid; grid-template-columns:105px minmax(0,1fr); gap:23px; padding:27px 0; border-bottom:1px solid var(--rule); transition:background .2s; }.research-art { color:var(--accent); background:var(--accent-soft); width:105px; height:120px; position:relative; border-radius:6px; overflow:hidden; }.research-art svg { width:100%; height:100%; opacity:.65; transition:transform .5s; }.research-card:hover svg { transform:scale(1.13) rotate(6deg); }.research-art>span { position:absolute; bottom:2px; right:7px; font-family:Georgia,serif; font-size:16px; background:var(--accent-soft); padding:0 3px; }.art-grid>span,.art-plus>span,.art-nodes>span { background:inherit; }.research-meta { display:flex; justify-content:space-between; gap:10px; font-size:9px; color:var(--muted); margin-bottom:5px; }.research-meta>span:first-child { text-transform:uppercase; letter-spacing:.09em; }.research-card h3 { font-size:16px; line-height:1.5; letter-spacing:-.3px; font-weight:500; margin-bottom:8px; }.research-award { color:var(--accent); font-size:10px; margin:-4px 0 4px; }.research-where { font-size:10px; color:var(--muted); margin:-4px 0 8px; }.research-award+.research-where { margin-top:0; }.research-text>p:not(.research-award,.research-where),.detail-copy p { font-size:12px; color:var(--muted); line-height:1.85; }.research-card summary { display:inline-flex; gap:18px; list-style:none; color:var(--accent); font-size:10px; cursor:pointer; margin-top:12px; }.research-card summary::-webkit-details-marker { display:none; }.research-card details[open] summary span { transform:rotate(90deg); }.detail-copy { margin-top:12px; padding-left:13px; border-left:2px solid var(--accent-soft); }.research-links { display:flex; flex-wrap:wrap; gap:6px 18px; margin-top:10px; font-size:11px; }.research-links a { color:var(--text); }
#projects,#background { margin-top:55px; }#research { margin-top:55px; }.publication { border:1px solid var(--rule); border-left:3px solid var(--accent); border-radius:0 6px 6px 0; padding:18px 24px 20px; background:var(--panel); }.publication-venue { color:var(--accent); font-size:10px; letter-spacing:.05em; }.publication-venue>span { color:var(--muted); }.publication h3 { font-family:'Newsreader',Georgia,serif; font-size:20px; line-height:1.3; margin:8px 0 9px; }.authors { font-size:11px; }.authors strong { font-weight:500; }.publication .small { font-size:10px; }.abstract { font-size:11px; line-height:1.7; color:var(--muted); margin-top:10px; text-align:justify; hyphens:auto; }.nb { white-space:nowrap; }.manuscript-note { margin-top:8px; color:var(--muted); font-style:italic; }summary { cursor:pointer; }
