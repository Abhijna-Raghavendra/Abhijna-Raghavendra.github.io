<script>
// Highlight the last section whose top has passed under the sticky header;
// at the bottom of the page, highlight the last section (Background is short).
const navLinks = document.querySelectorAll<HTMLAnchorElement>('.topbar nav a');
const sections = [...document.querySelectorAll<HTMLElement>('section[id]')];
const setActive = () => {
  let current = sections[0];
  for (const s of sections) if (s.getBoundingClientRect().top <= 130) current = s;
  if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) current = sections[sections.length - 1];
  navLinks.forEach(link => link.hash === `#${current.id}` ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current'));
};
let ticking = false;
addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(() => { setActive(); ticking = false; }); } }, {passive: true});
setActive();


// Background timeline: the bobblehead climbs from IIT Roorkee (bottom) towards the top as the
// section scrolls into view, and hops to whichever stop is hovered or focused.
const timeline = document.querySelector<HTMLElement>('.timeline');
const bobble = timeline?.querySelector<HTMLElement>('.bobble');
if (timeline && bobble) {
  const stops = [...timeline.querySelectorAll<HTMLElement>('.stop')];
  const head = bobble.querySelector<HTMLElement>('.bobble-head')!;
  let pinned: number | null = null, idle = 0;
  const centre = (el: HTMLElement) => el.offsetTop + el.querySelector<HTMLElement>('.stop-art')!.offsetHeight / 2 + 16;
  const place = () => {
    const ys = stops.map(centre), top = ys[0], bottom = ys[ys.length - 1];
    let y: number;
    if (pinned !== null) y = ys[pinned];
    else {
      // Start climbing as the timeline enters the screen; arrive by the time the page can't scroll further.
      const r = timeline.getBoundingClientRect();
      const maxScroll = document.documentElement.scrollHeight - innerHeight;
      const endTop = Math.max(innerHeight * 0.3, r.top + scrollY - maxScroll);
      const startTop = Math.max(endTop + 1, innerHeight * 0.9);
      const p = Math.min(1, Math.max(0, (startTop - r.top) / (startTop - endTop)));
      y = bottom - (bottom - top) * p; // climbs from IIT Roorkee up to Oracle
    }
    bobble.style.transform = `translateY(${y - head.offsetHeight / 2}px)`; // centre the face on the stop
    bobble.classList.add('moving');
    clearTimeout(idle); idle = window.setTimeout(() => bobble.classList.remove('moving'), 650);
  };
  stops.forEach((s, i) => {
    const go = () => { pinned = i; place(); };
    const leave = () => { pinned = null; place(); };
    s.addEventListener('mouseenter', go); s.addEventListener('focus', go);
    s.addEventListener('mouseleave', leave); s.addEventListener('blur', leave);
  });
  let queued = false;
  addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(() => { place(); queued = false; }); } }, {passive: true});
  // Re-aim while a stop's details open or close, since that moves the stops below it.
  new ResizeObserver(() => place()).observe(timeline.querySelector('.stops')!);
  addEventListener('resize', place);
  place();
}
</script>