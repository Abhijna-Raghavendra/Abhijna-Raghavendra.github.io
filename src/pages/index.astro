.stop:is(:hover,:focus,:focus-within) .stop-more { grid-template-rows:1fr; }
.bobble { position:absolute; left:50%; top:0; width:34px; margin-left:-17px; display:flex; flex-direction:column; align-items:center; color:var(--accent); transition:transform .55s cubic-bezier(.34,1.4,.64,1); will-change:transform; z-index:1; }
.bobble-head { width:34px; height:34px; border-radius:50%; background:url('/abhijna-raghavendra.jpeg') 42.5% 42% / 300% auto no-repeat; box-shadow:0 0 0 2px var(--bg), 0 0 0 3.5px var(--accent); transform-origin:50% 100%; }
